CodeSystem: ARVRegimenCS
Id: arv-regimen-cs
Title: "ART Regimen Code System"
Description: "National antiretroviral therapy (ART) regimen codes used by the Ethiopia HIV program, mirroring the codes recorded on the national ART register. Demo subset — to be expanded."

* ^content = #complete
* ^caseSensitive = true

// First-line regimens (adult/adolescent), per the national ART register
* #1a "d4T-3TC-NVP"
* #1c "AZT-3TC-NVP"
* #1d "AZT-3TC-EFV"
* #1e "TDF-3TC-EFV"
* #1f "TDF-3TC-NVP"
* #1g "ABC-3TC-EFV"
* #1j "TDF-3TC-DTG"
// Second-line / other
* #2f "AZT-3TC-ATV/r"
* #2h "TDF-3TC-ATV/r"
* #2i "ABC-3TC-LPV/r"
